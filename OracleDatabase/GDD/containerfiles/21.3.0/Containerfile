# ORACLE CONTAINERFILES PROJECT
# ----------------------------
# Oracle GSM 21c: regular image and prepared patching-base image.
# MAINTAINER <paramdeep.saini@oracle.com>,<jyoti.verma@oracle.com>>
#
# This is the Containerfile for Oracle GSM 21c
#
# REQUIRED FILES TO BUILD THIS IMAGE
# ----------------------------------
# (1) LINUX.X64_213000_gsm.zip
#     Download Oracle Database 21c GSM Software
#     from http://www.oracle.com/technetwork/database/enterprise-edition/downloads/index.html
#
# HOW TO BUILD THIS IMAGE
# -----------------------
# Place this file at containerfiles/21.3.0/Containerfile.
# Build from the containerfiles directory, which must contain:
#   21.3.0/LINUX.X64_213000_gsm.zip
#   21.3.0/21c_gsm_install.rsp
#   the existing 21.3.0 shell scripts and the shared scripts/ directory.
#
# Regular image:
#   podman build --target final --build-arg VERSION=21.3.0 \
#     --build-arg SLIMMING=false -f 21.3.0/Containerfile \
#     -t oracle/gsm:21.3.0 .
#
# Prepared patching-base image (no installed GSM home):
#   podman build --target final --build-arg VERSION=21.3.0 \
#     --build-arg SLIMMING=true -f 21.3.0/Containerfile \
#     -t oracle/gsm:21.3.0-base .

ARG SLIMMING=false
ARG BASE_IMAGE=oraclelinux:8
ARG BASE_OL_IMAGE=$BASE_IMAGE
ARG BASE_IMAGE_REF=oraclelinux:8
ARG BASE_IMAGE_DIGEST=unknown
ARG VERSION=21.3.0


# Pull base image
# ---------------
# hadolint ignore=DL3006,DL3025
FROM $BASE_OL_IMAGE AS base
# hadolint ignore=DL4006
RUN \
      mkdir -p /usr/share/oracle/image-metadata/rpms && \
      rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/oracle/image-metadata/rpms/base-image-rpms.txt && \
      rpm -qa --qf '%{NAME}\n' | sort -u > /usr/share/oracle/image-metadata/rpms/base-image-rpm-names.txt;

ARG BASE_IMAGE
ARG BASE_IMAGE_REF
ARG BASE_IMAGE_DIGEST
LABEL "org.opencontainers.image.base.name"="$BASE_IMAGE_REF" \
      "org.opencontainers.image.base.digest"="$BASE_IMAGE_DIGEST" \
      "com.oracle.database.base.image.chain.path"="/usr/share/oracle/image-metadata/base-image-chain.json"
ARG SLIMMING=false
ARG VERSION

# Labels
# ------
LABEL "provider"="Oracle"                                          \
      "issues"="https://github.com/oracle/docker-images/issues"    \
      "volume.setup.location1"="/opt/oracle/scripts"               \
      "port.listener"="1522"

# Argument to control removal of components not needed after db software installation

ARG INSTALL_FILE_1="LINUX.X64_213000_gsm.zip"
ARG USER="root"

ENV GSM_BASE="/u01/app/oracle" \
    GSM_USER="oracle" \
    GSM_HOME="/u01/app/oracle/product/21c/gsmhome_1" \
    INVENTORY="/u01/app/oracle/oraInventory" \
    INSTALL_DIR="/opt/oracle/scripts" \
    INSTALL_FILE_1=$INSTALL_FILE_1 \
    INSTALL_RSP="21c_gsm_install.rsp" \
    RUN_FILE="runOracle.sh" \
    SETUP_LINUX_FILE="setupLinuxEnv.sh" \
    CHECK_SPACE_FILE="checkSpace.sh" \
    USER_SCRIPTS_FILE="runUserScripts.sh" \
    INSTALL_GSM_BINARIES_FILE="installGSMBinaries.sh" \
    GSM_SETUP_FILE="setupOshardEnv.sh" \
    GSM_ENV_SETUP_FILE="setupGSM.sh" \
    GSM_SCRIPTS="scripts" \
    MAINPY="main.py" \
    PYTHON_FILE="/usr/bin/python" \
    PYTHON3_FILE="/usr/bin/python3" \
    ORAPCATALOG="orapcatalog.py" \
    CMDEXEC="cmdExec" \
    ORAMACHINE="oramachine.py" \
    ORALOGGER="oralogger.py" \
    ORAFACTORY="orafactory.py" \
    ORAGSM="oragsm.py" \
    ORASSHARD="orasshard.py" \
    ORAENV="oraenv.py" \
    ORAPSHARD="orapshard.py" \
    MAINPY="main.py" \
    ORASCATALOG="orascatalog.py" \
    ORACOMMON="oracommon.py" \
    DEMOAPPSQL="demoapp.sql" \
    RUNORASHARD="runOraShardSetup.sh" \
    CHECKLIVENESS="checkLiveness.sh"

# Use a second ENV so the preceding values are substituted.
# hadolint ignore=DL3044
ENV INSTALL_SCRIPTS=$INSTALL_DIR/install \
    ORACLE_HOME=$GSM_HOME \
    ORACLE_BASE=$GSM_BASE \
    SCRIPT_DIR=$INSTALL_DIR/sharding \
    SHARD_SCRIPT_DIR=$INSTALL_DIR/sharding \
    PATH=/bin:/usr/bin:/sbin:/usr/sbin \
    GSM_PATH=$GSM_HOME/bin:$PATH \
    GSM_LD_LIBRARY_PATH=$GSM_HOME/lib:/usr/lib:/lib

#############################################
# -------------------------------------------
# Start new stage for Non-Slim Image (regular image)
# -------------------------------------------
#############################################
FROM base AS gsm-image-slim-false
ARG SLIMMING
ARG VERSION

# Environment variables required for this build (do NOT change)
# -------------------------------------------------------------
# Linux Env Variable
ENV INSTALL_SCRIPTS=$INSTALL_DIR/install \
    ORACLE_HOME=$GSM_HOME \
    ORACLE_BASE=$GSM_BASE \
    SCRIPT_DIR=$INSTALL_DIR/sharding \
    PATH=/bin:/usr/bin:/sbin:/usr/sbin \
    GSM_PATH=$GSM_HOME/bin:$PATH \
    GSM_LD_LIBRARY_PATH=$GSM_HOME/lib:/usr/lib:/lib \
    INSTALL_SCRIPTS=$INSTALL_DIR/install \
    PATH=/bin:/usr/bin:/sbin:/usr/sbin \
    GSM_SCRIPTS="scripts"

# Copy binaries
# -------------
# COPY Binaries
COPY $VERSION/$SETUP_LINUX_FILE $VERSION/$CHECK_SPACE_FILE $VERSION/$GSM_ENV_SETUP_FILE $INSTALL_SCRIPTS/
COPY $VERSION/$RUN_FILE $VERSION/$GSM_SETUP_FILE $VERSION/$CHECKLIVENESS $VERSION/$USER_SCRIPTS_FILE $SCRIPT_DIR/
COPY $GSM_SCRIPTS/$ORAPCATALOG $GSM_SCRIPTS/$CMDEXEC $GSM_SCRIPTS/$ORAPSHARD $GSM_SCRIPTS/$MAINPY $GSM_SCRIPTS/$ORASCATALOG $GSM_SCRIPTS/$ORACOMMON $GSM_SCRIPTS/$DEMOAPPSQL $GSM_SCRIPTS/$RUNORASHARD $GSM_SCRIPTS/$CMDEXEC $GSM_SCRIPTS/$ORAMACHINE $GSM_SCRIPTS/$ORALOGGER $GSM_SCRIPTS/$ORAFACTORY $GSM_SCRIPTS/$ORAGSM  $GSM_SCRIPTS/$ORASSHARD $GSM_SCRIPTS/$ORAENV $SCRIPT_DIR/scripts/

# hadolint ignore=SC2086
RUN chmod 755 $INSTALL_DIR/install/*.sh && \
    sync && \
    $INSTALL_DIR/install/$CHECK_SPACE_FILE && \
    $INSTALL_DIR/install/$SETUP_LINUX_FILE && \
    $INSTALL_DIR/install/$GSM_ENV_SETUP_FILE && \
    sync

#############################################
# -------------------------------------------
# Start new stage for slim image
# It will also be used as base image for patching
# -------------------------------------------
#############################################
FROM base AS gsm-image-slim-true
ARG SLIMMING
ARG VERSION

# Environment variables required for this build (do NOT change)
# -------------------------------------------------------------
# Linux Env Variable
ENV  INSTALL_SCRIPTS=$INSTALL_DIR/install \
     ORACLE_HOME=$GSM_HOME \
     ORACLE_BASE=$GSM_BASE \
     SCRIPT_DIR=$INSTALL_DIR/sharding \
     PATH=/bin:/usr/bin:/sbin:/usr/sbin \
     GSM_PATH=$GSM_HOME/bin:$PATH \
     GSM_LD_LIBRARY_PATH=$GSM_HOME/lib:/usr/lib:/lib  \
     INSTALL_SCRIPTS=$INSTALL_DIR/install \
     PATH=/bin:/usr/bin:/sbin:/usr/sbin \
     GSM_SCRIPTS="scripts"

# Copy binaries
# -------------
# COPY Binaries
COPY $VERSION/$SETUP_LINUX_FILE $VERSION/$CHECK_SPACE_FILE $VERSION/$GSM_ENV_SETUP_FILE $INSTALL_SCRIPTS/
COPY $VERSION/$RUN_FILE $VERSION/$GSM_SETUP_FILE $VERSION/$CHECKLIVENESS $VERSION/$USER_SCRIPTS_FILE $SCRIPT_DIR/
COPY $GSM_SCRIPTS/$ORAPCATALOG $GSM_SCRIPTS/$ORAPSHARD $GSM_SCRIPTS/$CMDEXEC $GSM_SCRIPTS/$MAINPY $GSM_SCRIPTS/$ORASCATALOG $GSM_SCRIPTS/$ORACOMMON $GSM_SCRIPTS/$DEMOAPPSQL $GSM_SCRIPTS/$RUNORASHARD $GSM_SCRIPTS/$CMDEXEC $GSM_SCRIPTS/$ORAMACHINE $GSM_SCRIPTS/$ORALOGGER $GSM_SCRIPTS/$ORAFACTORY $GSM_SCRIPTS/$ORAGSM  $GSM_SCRIPTS/$ORASSHARD $GSM_SCRIPTS/$ORAENV $SCRIPT_DIR/scripts/

# hadolint ignore=SC2086
RUN chmod 755 $INSTALL_DIR/install/*.sh && \
    sync && \
    $INSTALL_DIR/install/$CHECK_SPACE_FILE && \
    $INSTALL_DIR/install/$SETUP_LINUX_FILE && \
    $INSTALL_DIR/install/$GSM_ENV_SETUP_FILE && \
    sync

#############################################
# -------------------------------------------
# Start new stage for installing the GSM
# only for SLIMMING=false
#############################################

# hadolint ignore=DL3006,DL3025
FROM gsm-image-slim-${SLIMMING} AS builder
ARG SLIMMING
ARG VERSION

COPY $VERSION/$INSTALL_FILE_1 $VERSION/$INSTALL_RSP $VERSION/$INSTALL_GSM_BINARIES_FILE $VERSION/$GSM_SETUP_FILE $INSTALL_DIR/install/

# Prepare permissions and system configuration as root.
USER ${USER}
# hadolint ignore=SC2086
RUN if [ "${SLIMMING}x" != 'truex' ]; then \
 chmod 755 $INSTALL_SCRIPTS/*.sh  && \
 sed -e '/hard *memlock/s/^/#/g' -i /etc/security/limits.d/oracle-database-preinstall-21c.conf && \
 sed -e '/ *nofile /s/^/#/g' -i /etc/security/limits.d/oracle-database-preinstall-21c.conf && \
    :;\
  fi

# Run only the GSM installer as oracle.
USER ${GSM_USER}
RUN if [ "${SLIMMING}x" != 'truex' ]; then \
 "$INSTALL_DIR/install/$INSTALL_GSM_BINARIES_FILE" && \
 :;\
fi

# Keep your existing root scripts and cleanup below this.
USER ${USER}
# hadolint ignore=SC2086
RUN if [ "${SLIMMING}x" != 'truex' ]; then \
   $INVENTORY/orainstRoot.sh && \
   $GSM_HOME/root.sh && \
   rm -rf $INSTALL_DIR/install && \
    rm -f /etc/sysctl.d/99-oracle-database-preinstall-21c-sysctl.conf && \
    rm -f /etc/sysctl.d/99-sysctl.conf && \
    rm -f /etc/rc.d/init.d/oracle-database-preinstall-21c-firstboot && \
    rm -f /etc/security/limits.d/oracle-database-preinstall-21c.conf && \
   :;\
   fi

#RUN if [ "${SLIMMING}x" == 'truex' ]; then \
#      mkdir /u01 && \
#      :; \
#fi

# hadolint ignore=SC2086
RUN rm -f $INSTALL_DIR/install/* && \
    sync

#############################################
# -------------------------------------------
# Start new layer for GSM runtime
# -------------------------------------------
#############################################
# hadolint ignore=DL3006,DL3025
FROM gsm-image-slim-${SLIMMING} AS final
ARG BASE_IMAGE
ARG BASE_IMAGE_REF
ARG BASE_IMAGE_DIGEST
RUN mkdir -p /usr/share/oracle/image-metadata && \
    printf '{\n  "schemaVersion": 1,\n  "images": [{"name": "%s", "digest": "%s", "reference": "%s", "role": "direct-base"}]\n}\n' \
      "$BASE_IMAGE_REF" "$BASE_IMAGE_DIGEST" "$BASE_IMAGE" > /usr/share/oracle/image-metadata/base-image-chain.json

# hadolint ignore=DL4006
RUN \
      rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/oracle/image-metadata/rpms/image-rpms.txt && \
      rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /tmp/image-rpm-details && \
      if [ -f /usr/share/oracle/image-metadata/rpms/base-image-rpm-names.txt ]; then \
        awk -F '\t' 'NR==FNR {base[$1]=1; next} !($1 in base) {print $1 "-" $2}' /usr/share/oracle/image-metadata/rpms/base-image-rpm-names.txt /tmp/image-rpm-details > /usr/share/oracle/image-metadata/rpms/image-added-rpms.txt; \
      else \
        cp /usr/share/oracle/image-metadata/rpms/image-rpms.txt /usr/share/oracle/image-metadata/rpms/image-added-rpms.txt; \
      fi && \
      rm -f /tmp/image-rpm-details;

COPY --from=builder /u01 /u01
# hadolint ignore=SC2086
RUN test -x "$PYTHON3_FILE" && \
    ln -sf $PYTHON3_FILE $PYTHON_FILE && \
    rm -f $INSTALL_DIR/install/*  && \
    cp $SCRIPT_DIR/scripts/cmdExec $SCRIPT_DIR/ && \
    for helper in cmdExec main.py orapcatalog.py orapshard.py orascatalog.py oracommon.py demoapp.sql runOraShardSetup.sh oramachine.py oralogger.py orafactory.py oragsm.py orasshard.py oraenv.py; do \
      ln -sf scripts/$helper $SHARD_SCRIPT_DIR/$helper; \
    done && \
    ln -sf ../$CHECKLIVENESS $SCRIPT_DIR/scripts/$CHECKLIVENESS && \
    chown -R oracle:oinstall $SCRIPT_DIR && \
    chmod 755 $SCRIPT_DIR/*.sh && \
    chmod 755 $SCRIPT_DIR/scripts/*.py && \
    chmod 755 $SCRIPT_DIR/scripts/*.sh && \
    chmod 755 $SCRIPT_DIR/scripts/cmdExec && \
    chmod 755 $SCRIPT_DIR/cmdExec && \
    sync


USER  ${GSM_USER}
WORKDIR /home/${GSM_USER}
EXPOSE 1522

VOLUME ["$GSM_BASE/oradata"]

HEALTHCHECK --interval=2m --start-period=25m \
   CMD "$SCRIPT_DIR/$CHECKLIVENESS" >/dev/null || exit 1

# hadolint ignore=DL3025
CMD exec $SCRIPT_DIR/$RUN_FILE
