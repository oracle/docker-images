# ORACLE DOCKERFILES PROJECT
# --------------------------
# This Dockerfile extends the base container image with pre-created database, intending improved startup in CI/CD pipelines
#
# REQUIREMENTS FOR THIS IMAGE
# ----------------------------------
# Oracle Single Instance Database container image Free version 23.26.0 onwards
#
# HOW TO BUILD THIS IMAGE
# -----------------------
#
# Run:
#      $ docker build -t <extended_image_name> . --build-arg BASE_IMAGE=oracle/database:23.26.0-free
#

ARG BASE_IMAGE=oracle/database:23.26.0-free
# hadolint ignore=DL3006
FROM ${BASE_IMAGE} AS prebuilt

ARG ORACLE_SID
ARG ORACLE_PWD
ARG ENABLE_ARCHIVELOG
ARG ENABLE_FORCE_LOGGING
ARG AUTO_MEM_CALCULATION

# Option to enable archivelog in pre-built database
ENV ENABLE_ARCHIVELOG=${ENABLE_ARCHIVELOG:-true}
ENV ENABLE_FORCE_LOGGING=${ENABLE_FORCE_LOGGING:-true}
ENV ORACLE_SID=${ORACLE_SID:-FREE}
ENV ORACLE_PWD=${ORACLE_PWD}
ENV AUTO_MEM_CALCULATION=${AUTO_MEM_CALCULATION:-false}

COPY --chown=oracle:dba setup/* "$ORACLE_BASE"/scripts/extensions/setup/
COPY --chown=oracle:dba configurePrebuiltPdb.sh "$SCRIPT_BASE_DIR"/configurePrebuiltPdb.sh
COPY --chown=oracle:dba startPrebuilt.sh "$ORACLE_BASE"/startPrebuilt.sh
COPY --chown=oracle:dba build/prepareFreeImage.sh /tmp/prepareFreeImage.sh
RUN chmod 755 "$ORACLE_BASE/startPrebuilt.sh"

# Creating the database
RUN "$ORACLE_BASE/$RUN_FILE" --nowait \
    && "$SCRIPT_BASE_DIR/${SHUTDOWN_FILE:-shutDown.sh}" immediate \
    && /bin/bash /tmp/prepareFreeImage.sh \
    && rm -f /tmp/prepareFreeImage.sh

# Rebuild the final image from the clean base stage so build-time database
# layers are not retained in the final image.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}-base

ARG ORACLE_SID
ARG ORACLE_PWD
ARG ENABLE_ARCHIVELOG
ARG ENABLE_FORCE_LOGGING
ARG AUTO_MEM_CALCULATION

ENV ENABLE_ARCHIVELOG=${ENABLE_ARCHIVELOG:-true}
ENV ENABLE_FORCE_LOGGING=${ENABLE_FORCE_LOGGING:-true}
ENV ORACLE_SID=${ORACLE_SID:-FREE}
ENV ORACLE_PWD=${ORACLE_PWD}
ENV AUTO_MEM_CALCULATION=${AUTO_MEM_CALCULATION:-false}

USER oracle
COPY --from=prebuilt $ORACLE_BASE $ORACLE_BASE
COPY --from=prebuilt /tmp/prebuilt-runtime /tmp/prebuilt-runtime

USER root
COPY build/finalizeFreeImage.sh /tmp/finalizeFreeImage.sh
RUN /bin/bash /tmp/finalizeFreeImage.sh \
    && rm -f /tmp/finalizeFreeImage.sh

USER oracle
WORKDIR /home/oracle

HEALTHCHECK --interval=1m --start-period=1m --timeout=30s \
   CMD "$ORACLE_BASE/$CHECK_DB_FILE" >/dev/null || exit 1

EXPOSE 1521/tcp

CMD [ "/bin/bash", "-c", "exec $ORACLE_BASE/startPrebuilt.sh" ]
